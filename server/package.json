{
  "name": "karnival-app-server",
  "version": "1.0.0",
  "description": "Karnival App Server",
  "main": "index.js",
  "scripts": {
    "watch": "tsc -w",
    "dev": "nodemon dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "gen-env": "npx gen-env-types .env -o src/env.d.ts -e .",
    "build": "tsc",
    "start": "node dist/index.js",
    "migration:show": "typeorm migration:show -d database/datasource.js",
    "migration:run": "typeorm migration:run -d database/datasource.js",
    "migration:revert": "typeorm migration:revert -d database/datasource.js"
  },
  "author": "Guruh Edi Purwanto",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@faker-js/faker": "^9.8.0",
    "@types/cors": "^2.8.8",
    "@types/express": "^4.17.8",
    "@types/express-session": "^1.18.1",
    "@types/node": "^14.11.7",
    "@types/passport": "^1.0.6",
    "@types/passport-github2": "^1.2.4",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "nodemon": "^2.0.4",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.32.1"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "argon2": "^0.27.0",
    "aws-jwt-verify": "^5.0.0",
    "class-validator": "^0.13.1",
    "cors": "^2.8.5",
    "dataloader": "^2.0.0",
    "dotenv-safe": "^8.2.0",
    "express": "^4.17.1",
    "express-session": "^1.18.1",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.2",
    "passport": "^0.4.1",
    "passport-github2": "^0.1.12",
    "pg": "^8.4.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.2",
    "typeorm": "^0.3.23"
  }
}
